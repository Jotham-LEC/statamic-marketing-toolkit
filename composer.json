{
    "name": "jotham-lec/statamic-co-seo",
    "description": "SEO that tells you what to fix: meta tags, sitemaps, hreflang and redirects, plus Google Search Console numbers, site reports and share images on Pro.",
    "type": "statamic-addon",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "JothamLec\\Seo\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JothamLec\\Seo\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.30",
        "simonhamp/the-og": "^0.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "statamic": {
            "name": "Co-SEO",
            "description": "SEO that tells you what to fix: Google's numbers beside a site audit, share cards, redirects and hreflang",
            "slug": "seo",
            "editions": [
                "free",
                "pro"
            ]
        },
        "laravel": {
            "providers": [
                "JothamLec\\Seo\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
