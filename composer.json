{
    "name": "jotham-lec/statamic-marketing-toolkit",
    "description": "The marketing fundamentals for a Statamic website: SEO, tracking tags, Consent Mode, favicons and redirects, plus Search Console numbers, site reports with a score and conversion events on Pro.",
    "type": "statamic-addon",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "JothamLec\\MarketingToolkit\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JothamLec\\MarketingToolkit\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "simonhamp/the-og": "^0.8",
        "statamic/cms": "^6.34"
    },
    "suggest": {
        "ext-gd": "Draws favicons when Imagick isn't installed",
        "ext-imagick": "Draws the share cards (Pro) and favicons"
    },
    "replace": {
        "jotham-lec/statamic-co-seo": "self.version"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^4.0"
    },
    "scripts": {
        "test": "pest --parallel",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "statamic": {
            "name": "Marketing Toolkit",
            "description": "The marketing fundamentals for your Statamic site: SEO, tracking, consent, favicons and redirects",
            "slug": "marketing-toolkit",
            "editions": [
                "free",
                "pro"
            ]
        },
        "laravel": {
            "providers": [
                "JothamLec\\MarketingToolkit\\ServiceProvider"
            ]
        }
    }
}
