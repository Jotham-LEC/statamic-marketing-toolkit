includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
        - routes
    ignoreErrors:
        # Statamic's contracts don't declare most methods its classes implement (Entry::absoluteUrl, Term::in, User::can…).
        -
            identifier: method.notFound
            message: '#Statamic\\(Contracts|CP)\\#'
        # Larastan doesn't know views in an addon's namespace (marketing-toolkit::meta).
        -
            identifier: argument.type
            message: '#expects view-string\|null#'
        # Statamic's docblock says Addon::get() always returns an Addon; it returns null for one not installed.
        -
            identifier: nullsafe.neverNull
            message: '#Statamic\\Addons\\Addon#'
        -
            identifier: nullCoalesce.expr
            path: src/Reports/ReportSettings.php
        # Statamic's docblock: manipulate() returns a string only when given no item.
        -
            identifier: method.nonObject
            message: '#ImageManipulator\|string#'
        # PHPStan 2.3 types filter_var() with FILTER_FLAG_GLOBAL_RANGE as always a string; for a private or reserved
        # address it returns false, which is the SSRF check. (2.2 gets it right, hence reportUnmatched.)
        -
            identifier: booleanNot.alwaysFalse
            path: src/Reports/ExternalLinkChecker.php
            reportUnmatched: false
