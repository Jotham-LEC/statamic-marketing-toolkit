{
    "brand": {
        "display": "seo::fields.brand.tabs.brand",
        "sections": [
            {
                "fields": [
                    {
                        "handle": "title_site_name",
                        "field": {
                            "type": "toggle",
                            "display": "seo::fields.brand.title_site_name.display",
                            "width": 50,
                            "instructions": "seo::fields.brand.title_site_name.instructions"
                        }
                    },
                    {
                        "handle": "title_separator",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.title_separator.display",
                            "width": 50,
                            "placeholder": "·",
                            "if": {
                                "title_site_name": "true"
                            },
                            "instructions": "seo::fields.brand.title_separator.instructions"
                        }
                    },
                    {
                        "handle": "default_description",
                        "field": {
                            "type": "textarea",
                            "display": "seo::fields.brand.default_description.display",
                            "character_limit": 160,
                            "instructions": "seo::fields.brand.default_description.instructions"
                        }
                    },
                    {
                        "handle": "default_image",
                        "field": {
                            "type": "assets",
                            "display": "seo::fields.brand.default_image.display",
                            "container": "assets",
                            "max_files": 1,
                            "instructions": "seo::fields.brand.default_image.instructions"
                        }
                    },
                    {
                        "handle": "site_alternate_name",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.site_alternate_name.display",
                            "width": 50,
                            "instructions": "seo::fields.brand.site_alternate_name.instructions"
                        }
                    },
                    {
                        "handle": "twitter_handle",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.twitter_handle.display",
                            "width": 50,
                            "prepend": "@"
                        }
                    }
                ]
            },
            {
                "display": "seo::fields.brand.sections.icon.display",
                "instructions": "seo::fields.brand.sections.icon.instructions",
                "fields": [
                    {
                        "handle": "favicon",
                        "field": {
                            "type": "assets",
                            "display": "seo::fields.brand.favicon.display",
                            "container": "assets",
                            "max_files": 1,
                            "instructions": "seo::fields.brand.favicon.instructions"
                        }
                    },
                    {
                        "handle": "theme_color",
                        "field": {
                            "type": "color",
                            "display": "seo::fields.brand.theme_color.display",
                            "width": 50,
                            "instructions": "seo::fields.brand.theme_color.instructions"
                        }
                    },
                    {
                        "handle": "background_color",
                        "field": {
                            "type": "color",
                            "display": "seo::fields.brand.background_color.display",
                            "width": 50,
                            "instructions": "seo::fields.brand.background_color.instructions"
                        }
                    }
                ]
            }
        ]
    },
    "publisher": {
        "display": "seo::fields.brand.tabs.publisher",
        "sections": [
            {
                "instructions": "seo::fields.brand.sections.publisher.instructions",
                "fields": [
                    {
                        "handle": "publisher_type",
                        "field": {
                            "type": "select",
                            "display": "seo::fields.brand.publisher_type.display",
                            "width": 50,
                            "multiple": true,
                            "taggable": true,
                            "default": [
                                "Organization"
                            ],
                            "options": {
                                "Organization": "seo::fields.brand.publisher_type.options.organization",
                                "Corporation": "seo::fields.brand.publisher_type.options.corporation",
                                "EducationalOrganization": "seo::fields.brand.publisher_type.options.educational_organization",
                                "NGO": "seo::fields.brand.publisher_type.options.ngo",
                                "LocalBusiness": "seo::fields.brand.publisher_type.options.local_business",
                                "Store": "seo::fields.brand.publisher_type.options.store",
                                "ProfessionalService": "seo::fields.brand.publisher_type.options.professional_service",
                                "Restaurant": "seo::fields.brand.publisher_type.options.restaurant",
                                "Person": "seo::fields.brand.publisher_type.options.person"
                            },
                            "instructions": "seo::fields.brand.publisher_type.instructions"
                        }
                    },
                    {
                        "handle": "publisher_name",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.publisher_name.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "publisher_alternate_name",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.publisher_alternate_name.display",
                            "width": 50,
                            "instructions": "seo::fields.brand.publisher_alternate_name.instructions"
                        }
                    },
                    {
                        "handle": "founding_date",
                        "field": {
                            "type": "date",
                            "display": "seo::fields.brand.founding_date.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "publisher_description",
                        "field": {
                            "type": "textarea",
                            "display": "seo::fields.brand.publisher_description.display"
                        }
                    },
                    {
                        "handle": "publisher_logo",
                        "field": {
                            "type": "assets",
                            "display": "seo::fields.brand.publisher_logo.display",
                            "container": "assets",
                            "max_files": 1,
                            "instructions": ""
                        }
                    },
                    {
                        "handle": "job_title",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.job_title.display",
                            "width": 50,
                            "if": {
                                "publisher_type": "contains Person"
                            }
                        }
                    },
                    {
                        "handle": "telephone",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.telephone.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "email",
                        "field": {
                            "type": "text",
                            "input_type": "email",
                            "display": "seo::fields.brand.email.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "area_served",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.area_served.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "same_as",
                        "field": {
                            "type": "list",
                            "display": "seo::fields.brand.same_as.display",
                            "instructions": "seo::fields.brand.same_as.instructions"
                        }
                    },
                    {
                        "handle": "contact_points",
                        "field": {
                            "type": "grid",
                            "display": "seo::fields.brand.contact_points.display",
                            "mode": "table",
                            "add_row": "seo::fields.brand.contact_points.add_row",
                            "fields": [
                                {
                                    "handle": "contact_type",
                                    "field": {
                                        "type": "text",
                                        "display": "seo::fields.brand.contact_type.display",
                                        "placeholder": "seo::fields.brand.contact_type.placeholder"
                                    }
                                },
                                {
                                    "handle": "telephone",
                                    "field": {
                                        "type": "text",
                                        "display": "seo::fields.brand.telephone.display"
                                    }
                                },
                                {
                                    "handle": "email",
                                    "field": {
                                        "type": "text",
                                        "display": "seo::fields.brand.email.display"
                                    }
                                }
                            ]
                        }
                    }
                ]
            },
            {
                "display": "seo::fields.brand.sections.address.display",
                "instructions": "seo::fields.brand.sections.address.instructions",
                "fields": [
                    {
                        "handle": "street_address",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.street_address.display"
                        }
                    },
                    {
                        "handle": "address_locality",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.address_locality.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "address_region",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.address_region.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "postal_code",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.postal_code.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "address_country",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.address_country.display",
                            "width": 50,
                            "placeholder": "MY, AU, US…"
                        }
                    }
                ]
            },
            {
                "display": "seo::fields.brand.sections.local_business.display",
                "instructions": "seo::fields.brand.sections.local_business.instructions",
                "fields": [
                    {
                        "handle": "price_range",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.price_range.display",
                            "width": 33,
                            "placeholder": "$$"
                        }
                    },
                    {
                        "handle": "latitude",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.latitude.display",
                            "width": 33
                        }
                    },
                    {
                        "handle": "longitude",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.longitude.display",
                            "width": 33
                        }
                    },
                    {
                        "handle": "opening_hours",
                        "field": {
                            "type": "grid",
                            "display": "seo::fields.brand.opening_hours.display",
                            "mode": "table",
                            "add_row": "seo::fields.brand.opening_hours.add_row",
                            "fields": [
                                {
                                    "handle": "days",
                                    "field": {
                                        "type": "checkboxes",
                                        "display": "seo::fields.brand.days.display",
                                        "inline": true,
                                        "options": {
                                            "Monday": "seo::fields.brand.days.options.monday",
                                            "Tuesday": "seo::fields.brand.days.options.tuesday",
                                            "Wednesday": "seo::fields.brand.days.options.wednesday",
                                            "Thursday": "seo::fields.brand.days.options.thursday",
                                            "Friday": "seo::fields.brand.days.options.friday",
                                            "Saturday": "seo::fields.brand.days.options.saturday",
                                            "Sunday": "seo::fields.brand.days.options.sunday"
                                        }
                                    }
                                },
                                {
                                    "handle": "opens",
                                    "field": {
                                        "type": "time",
                                        "display": "seo::fields.brand.opens.display"
                                    }
                                },
                                {
                                    "handle": "closes",
                                    "field": {
                                        "type": "time",
                                        "display": "seo::fields.brand.closes.display"
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        ]
    },
    "tracking": {
        "display": "seo::fields.brand.tabs.tracking",
        "sections": [
            {
                "instructions": "seo::fields.brand.sections.tracking.instructions",
                "fields": [
                    {
                        "handle": "tracking_overlap",
                        "field": {
                            "type": "section",
                            "display": "seo::fields.brand.tracking_overlap.display",
                            "instructions": "seo::fields.brand.tracking_overlap.instructions",
                            "if": "seoTrackingOverlap"
                        }
                    },
                    {
                        "handle": "gtm_id",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.gtm_id.display",
                            "width": 50,
                            "placeholder": "GTM-XXXXXXX",
                            "instructions": "seo::fields.brand.gtm_id.instructions",
                            "validate": [
                                "nullable",
                                "regex:/^GTM-[A-Z0-9]{4,12}$/i"
                            ]
                        }
                    },
                    {
                        "handle": "ga4_id",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.ga4_id.display",
                            "width": 50,
                            "placeholder": "G-XXXXXXXXXX",
                            "validate": [
                                "nullable",
                                "regex:/^G-[A-Z0-9]{4,16}$/i"
                            ]
                        }
                    },
                    {
                        "handle": "posthog_key",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.posthog_key.display",
                            "width": 50,
                            "placeholder": "phc_…",
                            "validate": [
                                "nullable",
                                "regex:/^phc_[A-Za-z0-9]{16,64}$/"
                            ]
                        }
                    },
                    {
                        "handle": "posthog_host",
                        "field": {
                            "type": "text",
                            "input_type": "url",
                            "display": "seo::fields.brand.posthog_host.display",
                            "width": 50,
                            "placeholder": "https://us.i.posthog.com",
                            "instructions": "seo::fields.brand.posthog_host.instructions"
                        }
                    },
                    {
                        "handle": "meta_pixel_id",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.meta_pixel_id.display",
                            "width": 50,
                            "validate": [
                                "nullable",
                                "regex:/^\\d{6,20}$/"
                            ]
                        }
                    },
                    {
                        "handle": "linkedin_partner_id",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.linkedin_partner_id.display",
                            "width": 50,
                            "validate": [
                                "nullable",
                                "regex:/^\\d{3,12}$/"
                            ]
                        }
                    }
                ]
            },
            {
                "display": "seo::fields.brand.sections.consent.display",
                "instructions": "seo::fields.brand.sections.consent.instructions",
                "fields": [
                    {
                        "handle": "consent_mode",
                        "field": {
                            "type": "toggle",
                            "display": "seo::fields.brand.consent_mode.display",
                            "instructions": "seo::fields.brand.consent_mode.instructions"
                        }
                    },
                    {
                        "handle": "consent_ad_storage",
                        "field": {
                            "type": "button_group",
                            "display": "seo::fields.brand.consent_ad_storage.display",
                            "width": 50,
                            "default": "denied",
                            "if": {
                                "consent_mode": "true"
                            },
                            "options": {
                                "denied": "seo::fields.brand.consent_value.options.denied",
                                "granted": "seo::fields.brand.consent_value.options.granted"
                            }
                        }
                    },
                    {
                        "handle": "consent_analytics_storage",
                        "field": {
                            "type": "button_group",
                            "display": "seo::fields.brand.consent_analytics_storage.display",
                            "width": 50,
                            "default": "denied",
                            "if": {
                                "consent_mode": "true"
                            },
                            "options": {
                                "denied": "seo::fields.brand.consent_value.options.denied",
                                "granted": "seo::fields.brand.consent_value.options.granted"
                            }
                        }
                    },
                    {
                        "handle": "consent_ad_user_data",
                        "field": {
                            "type": "button_group",
                            "display": "seo::fields.brand.consent_ad_user_data.display",
                            "width": 50,
                            "default": "denied",
                            "if": {
                                "consent_mode": "true"
                            },
                            "options": {
                                "denied": "seo::fields.brand.consent_value.options.denied",
                                "granted": "seo::fields.brand.consent_value.options.granted"
                            }
                        }
                    },
                    {
                        "handle": "consent_ad_personalization",
                        "field": {
                            "type": "button_group",
                            "display": "seo::fields.brand.consent_ad_personalization.display",
                            "width": 50,
                            "default": "denied",
                            "if": {
                                "consent_mode": "true"
                            },
                            "options": {
                                "denied": "seo::fields.brand.consent_value.options.denied",
                                "granted": "seo::fields.brand.consent_value.options.granted"
                            }
                        }
                    },
                    {
                        "handle": "consent_wait_for_update",
                        "field": {
                            "type": "integer",
                            "display": "seo::fields.brand.consent_wait_for_update.display",
                            "width": 50,
                            "default": 500,
                            "append": "ms",
                            "if": {
                                "consent_mode": "true"
                            },
                            "instructions": "seo::fields.brand.consent_wait_for_update.instructions"
                        }
                    },
                    {
                        "handle": "consent_regions",
                        "field": {
                            "type": "select",
                            "display": "seo::fields.brand.consent_regions.display",
                            "width": 50,
                            "multiple": true,
                            "taggable": true,
                            "options": {
                                "EEA": "seo::fields.brand.consent_regions.options.eea"
                            },
                            "if": {
                                "consent_mode": "true"
                            },
                            "instructions": "seo::fields.brand.consent_regions.instructions"
                        }
                    }
                ]
            },
            {
                "display": "seo::fields.brand.sections.conversions.display",
                "instructions": "seo::fields.brand.sections.conversions.instructions",
                "fields": [
                    {
                        "handle": "conversions",
                        "field": {
                            "type": "toggle",
                            "display": "seo::fields.brand.conversions.display",
                            "default": true,
                            "width": 50,
                            "instructions": "seo::fields.brand.conversions.instructions"
                        }
                    },
                    {
                        "handle": "linkedin_conversion_id",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.linkedin_conversion_id.display",
                            "width": 50,
                            "if": {
                                "conversions": "true"
                            },
                            "validate": [
                                "nullable",
                                "regex:/^\\d{3,12}$/"
                            ]
                        }
                    },
                    {
                        "handle": "attribution",
                        "field": {
                            "type": "toggle",
                            "display": "seo::fields.brand.attribution.display",
                            "width": 50,
                            "instructions": "seo::fields.brand.attribution.instructions"
                        }
                    }
                ]
            }
        ]
    },
    "shop": {
        "display": "seo::fields.brand.tabs.shop",
        "sections": [
            {
                "instructions": "seo::fields.brand.sections.shop.instructions",
                "fields": [
                    {
                        "handle": "currency",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.currency.display",
                            "width": 33,
                            "placeholder": "MYR, AUD, USD…",
                            "instructions": "seo::fields.brand.currency.instructions"
                        }
                    }
                ]
            },
            {
                "display": "seo::fields.brand.sections.returns.display",
                "fields": [
                    {
                        "handle": "return_category",
                        "field": {
                            "type": "select",
                            "display": "seo::fields.brand.return_category.display",
                            "width": 33,
                            "options": {
                                "MerchantReturnFiniteReturnWindow": "seo::fields.brand.return_category.options.finite_window",
                                "MerchantReturnUnlimitedWindow": "seo::fields.brand.return_category.options.unlimited_window",
                                "MerchantReturnNotPermitted": "seo::fields.brand.return_category.options.not_permitted"
                            }
                        }
                    },
                    {
                        "handle": "return_days",
                        "field": {
                            "type": "integer",
                            "display": "seo::fields.brand.return_days.display",
                            "width": 33,
                            "if": {
                                "return_category": "equals MerchantReturnFiniteReturnWindow"
                            }
                        }
                    },
                    {
                        "handle": "return_country",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.return_country.display",
                            "width": 33,
                            "placeholder": "MY"
                        }
                    },
                    {
                        "handle": "return_policy_link",
                        "field": {
                            "type": "text",
                            "input_type": "url",
                            "display": "seo::fields.brand.return_policy_link.display",
                            "instructions": "seo::fields.brand.return_policy_link.instructions"
                        }
                    }
                ]
            },
            {
                "display": "seo::fields.brand.sections.shipping.display",
                "fields": [
                    {
                        "handle": "shipping_rates",
                        "field": {
                            "type": "grid",
                            "display": "seo::fields.brand.shipping_rates.display",
                            "mode": "table",
                            "add_row": "seo::fields.brand.shipping_rates.add_row",
                            "instructions": "seo::fields.brand.shipping_rates.instructions",
                            "fields": [
                                {
                                    "handle": "country",
                                    "field": {
                                        "type": "text",
                                        "display": "seo::fields.brand.country.display"
                                    }
                                },
                                {
                                    "handle": "region",
                                    "field": {
                                        "type": "text",
                                        "display": "seo::fields.brand.region.display"
                                    }
                                },
                                {
                                    "handle": "min_order",
                                    "field": {
                                        "type": "float",
                                        "display": "seo::fields.brand.min_order.display"
                                    }
                                },
                                {
                                    "handle": "max_order",
                                    "field": {
                                        "type": "float",
                                        "display": "seo::fields.brand.max_order.display"
                                    }
                                },
                                {
                                    "handle": "rate",
                                    "field": {
                                        "type": "float",
                                        "display": "seo::fields.brand.rate.display"
                                    }
                                },
                                {
                                    "handle": "min_days",
                                    "field": {
                                        "type": "integer",
                                        "display": "seo::fields.brand.min_days.display"
                                    }
                                },
                                {
                                    "handle": "max_days",
                                    "field": {
                                        "type": "integer",
                                        "display": "seo::fields.brand.max_days.display"
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        ]
    },
    "share_cards": {
        "display": "seo::fields.brand.tabs.share_cards",
        "sections": [
            {
                "instructions": "seo::fields.brand.sections.share_cards.instructions",
                "fields": [
                    {
                        "handle": "og_background",
                        "field": {
                            "type": "color",
                            "display": "seo::fields.brand.og_background.display",
                            "width": 33
                        }
                    },
                    {
                        "handle": "og_text",
                        "field": {
                            "type": "color",
                            "display": "seo::fields.brand.og_text.display",
                            "width": 33
                        }
                    },
                    {
                        "handle": "og_accent",
                        "field": {
                            "type": "color",
                            "display": "seo::fields.brand.og_accent.display",
                            "width": 33
                        }
                    },
                    {
                        "handle": "og_picture",
                        "field": {
                            "type": "assets",
                            "display": "seo::fields.brand.og_picture.display",
                            "container": "assets",
                            "max_files": 1,
                            "instructions": "seo::fields.brand.og_picture.instructions"
                        }
                    }
                ]
            }
        ]
    },
    "crawlers": {
        "display": "seo::fields.brand.tabs.crawlers",
        "sections": [
            {
                "fields": [
                    {
                        "handle": "google_verification",
                        "field": {
                            "type": "text",
                            "display": "seo::fields.brand.google_verification.display",
                            "width": 50
                        }
                    },
                    {
                        "handle": "bing_verification",
